# FebGrid Environment Example

# App
APP_NAME=FebGrid
ENVIRONMENT=development

# Backend
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
DATABASE_URL=

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Frontend
VITE_API_BASE_URL=http://localhost:8000
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Auth
JWT_SECRET_KEY=

# AI
AI_PROVIDER_MODE=mock
AI_EXTERNAL_PROCESSING_ENABLED=false
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Optional custom Groq-compatible endpoint. Leave blank for the official Groq SDK default.
GROQ_BASE_URL=
GROQ_TIMEOUT_SECONDS=30
GROQ_MAX_RETRIES=2
GROQ_MAX_INPUT_CHARS=12000
AI_DEFAULT_TEMPERATURE=0.2
AI_DEFAULT_MAX_TOKENS=800

# File Uploads
UPLOAD_PROVIDER=supabase
SUPABASE_STORAGE_BUCKET=work-files

# CORS
CORS_ORIGINS=http://localhost:5173
